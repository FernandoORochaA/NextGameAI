@model NextGameAI.Web.Models.LibraryEntry
@{ ViewData["Title"] = "Detalhes do jogo"; }
<h1>@Model.Game.Title</h1>
@if (Model.Game.IgdbId.HasValue)
{ <partial name="_CatalogMetadata" model="NextGameAI.Web.ViewModels.CatalogGameResult.FromGame(Model.Game)" /> }
else if (Model.Game.EditionTitle is not null) { <p>Edição: @Model.Game.EditionTitle</p> }
<dl>
    <dt>Status</dt><dd>@Html.DisplayFor(x => x.Status)</dd>
    <dt>Avaliação</dt><dd><partial name="_Rating" model="Model" /></dd>
    <dt>Observações</dt><dd style="white-space: pre-wrap">@(Model.Notes ?? "Sem observações.")</dd>
    @if (Model.Status == NextGameAI.Web.Models.LibraryStatus.Abandoned)
    {
        <dt>Motivo de abandono</dt><dd style="white-space: pre-wrap">@(Model.AbandonmentReason ?? "Não informado.")</dd>
    }
</dl>
<h2>Plataformas</h2>
<partial name="_Platforms" model="Model.Ownerships" />
<p><a asp-action="Edit" asp-route-id="@Model.Id">Editar</a> |
    <a asp-action="Delete" asp-route-id="@Model.Id">Excluir</a> |
    <a asp-action="Index">Voltar à biblioteca</a></p>
