@model NextGameAI.Web.ViewModels.SimpleLibraryForm
@{ ViewData["Title"] = "Cadastrar jogo"; }
<div class="library-form">
    <h1>Cadastrar jogo</h1>
    <form asp-action="Create" method="post">
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <partial name="_Form" model="Model" />
        <button class="btn btn-primary" type="submit">Cadastrar</button>
        <a asp-action="Index" class="ms-2">Cancelar</a>
    </form>
</div>
@section Scripts { <script src="~/js/library-form.js" asp-append-version="true"></script> }
