@model NextGameAI.Web.ViewModels.SimpleLibraryForm
@{ ViewData["Title"] = "Cadastrar jogo"; }
<div class="library-form">
    <h1>Cadastrar jogo</h1>
    <form asp-action="Create" method="post">
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <partial name="_Form" model="Model" />
        @if (Model.DuplicateEntryId.HasValue)
        {
            <p><a asp-action="Details" asp-route-id="@Model.DuplicateEntryId">Ver detalhes</a> |
                <a asp-action="Edit" asp-route-id="@Model.DuplicateEntryId">Editar jogo cadastrado</a></p>
        }
        <button class="btn btn-primary" type="submit">Cadastrar</button>
        <a asp-action="Index" class="ms-2">Cancelar</a>
    </form>
    <p class="mt-3"><a asp-controller="Catalog" asp-action="Index">Voltar à pesquisa</a></p>
</div>
@section Scripts { <script src="~/js/library-form.js" asp-append-version="true"></script> }
